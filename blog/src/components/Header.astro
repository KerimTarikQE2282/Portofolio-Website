---
import { withBase, stripBase, isEmbedded } from '../lib/url';
import { SITE_TITLE } from '../consts';
import { sections } from '../lib/sections';

const path = stripBase(Astro.url.pathname);
---

<header class="site-header">
  <div class="container inner">
    <div class="left">
      {
        isEmbedded && (
          <a href="/" class="back" aria-label="Back to portfolio">
            <span class="prompt" aria-hidden="true">$</span>cd ~/portfolio
          </a>
        )
      }
      <a href={withBase('/')} class="brand" aria-label={`${SITE_TITLE} — home`}>
        <span class="prompt" aria-hidden="true">~/</span>{SITE_TITLE}
      </a>
    </div>
    <nav aria-label="Sections">
      <ul>
        {
          sections.map((s) => {
            const active = path.startsWith(`/${s.id}/`) || path === `/${s.id}`;
            return (
              <li>
                <a
                  href={withBase(`/${s.id}/`)}
                  aria-current={active ? 'page' : undefined}
                  style={`--link-accent: ${s.accent}`}
                >
                  {s.title}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    padding-top: env(safe-area-inset-top);
    z-index: 50;
    border-bottom: 1px solid var(--border);
    background: rgb(250 250 250 / 0.8);
    backdrop-filter: saturate(160%) blur(14px);
    -webkit-backdrop-filter: saturate(160%) blur(14px);
  }

  .inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    height: 3.75rem;
  }

  .left {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-width: 0;
  }

  /* Way back to the portfolio (only rendered when the blog is embedded under /blog) */
  .back {
    display: inline-flex;
    align-items: center;
    min-height: 2.25rem;
    padding: 0.3rem 0.7rem;
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    background: #09090b;
    color: #fafafa;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    white-space: nowrap;
    transition: background 0.15s, transform 0.15s;
  }

  .back:hover {
    background: var(--accent);
    transform: translateX(-2px);
  }

  .back .prompt {
    color: #4ade80;
    margin-right: 0.45em;
  }

  .back:hover .prompt {
    color: #fafafa;
  }

  .brand {
    font-family: var(--font-mono);
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }

  .prompt {
    color: var(--accent);
    margin-right: 0.15em;
  }

  ul {
    display: flex;
    gap: 0.25rem;
    padding: 0;
    list-style: none;
  }

  nav a {
    position: relative;
    display: block;
    padding: 0.4rem 0.7rem;
    border-radius: var(--radius-sm);
    color: var(--text-muted);
    font-size: 0.9rem;
    font-weight: 500;
    transition: color 0.15s, background 0.15s;
  }

  nav a:hover {
    color: var(--text);
    background: var(--surface-2);
  }

  nav a[aria-current='page'] {
    color: var(--text);
  }

  nav a[aria-current='page']::after {
    content: '';
    position: absolute;
    left: 0.7rem;
    right: 0.7rem;
    bottom: -0.68rem;
    height: 2px;
    border-radius: 2px;
    background: var(--link-accent);
  }

  /* Narrow phones: nav drops to its own row under the brand and scrolls sideways if needed */
  @media (max-width: 479px) {
    .inner {
      flex-wrap: wrap;
      gap: 0.15rem 1rem;
      height: auto;
      padding-block: 0.6rem 0.35rem;
    }

    nav {
      width: 100%;
      margin-inline: -0.5rem;
      overflow-x: auto;
      scrollbar-width: none;
    }

    nav::-webkit-scrollbar {
      display: none;
    }

    nav a {
      padding: 0.55rem 0.6rem;
      font-size: 0.875rem;
      white-space: nowrap;
    }

    nav a[aria-current='page']::after {
      bottom: 0.1rem;
    }
  }
</style>
