---
import { withBase } from '../lib/url';
import type { Section } from '../lib/sections';
import SectionIcon from './SectionIcon.astro';
import FormattedDate from './FormattedDate.astro';

interface Props {
  section: Section;
  index: number;
  count: number;
  latest?: Date;
}

const { section, index, count, latest } = Astro.props;
---

<a href={withBase(`/${section.id}/`)} class="card" style={`--card-accent: ${section.accent}`}>
  <div class="top">
    <span class="icon"><SectionIcon name={section.icon} /></span>
    <span class="index mono" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
  </div>

  <div class="body">
    <p class="tagline mono">{section.tagline}</p>
    <h2>{section.title}</h2>
    <p class="description">{section.description}</p>
  </div>

  <div class="meta">
    <span class="stats mono">
      {count} {count === 1 ? 'post' : 'posts'}
      {
        latest && (
          <>
            <span class="dot" aria-hidden="true">·</span>
            <FormattedDate date={latest} format="short" />
          </>
        )
      }
    </span>
    <span class="cta">
      Browse
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
    </span>
  </div>
</a>

<style>
  .card {
    --lift: 0px;
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    min-height: 100%;
    padding: 1.6rem 1.6rem 1.4rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
    box-shadow: var(--shadow-2);
    transform: translateY(var(--lift));
    transition:
      transform 0.4s var(--ease-out),
      box-shadow 0.4s var(--ease-out),
      border-color 0.25s;
  }

  .card:hover,
  .card:focus-visible {
    --lift: -4px;
    border-color: var(--border-strong);
    box-shadow: var(--shadow-3);
  }

  .card:focus-visible {
    outline: 2px solid var(--card-accent);
    outline-offset: 4px;
  }

  .card:active {
    --lift: -2px;
  }

  .top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .icon {
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--surface-2);
    color: var(--card-accent);
  }

  .index {
    color: var(--text-faint);
    font-size: 0.78rem;
    letter-spacing: 0.08em;
  }

  .body {
    flex: 1;
  }

  .tagline {
    margin-bottom: 0.4rem;
    color: var(--card-accent);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h2 {
    margin-bottom: 0.6rem;
    font-size: 1.6rem;
    font-weight: 600;
  }

  .description {
    color: var(--text-muted);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 1.1rem;
    border-top: 1px solid var(--border);
  }

  .stats {
    color: var(--text-faint);
    font-size: 0.76rem;
  }

  .dot {
    margin-inline: 0.4em;
  }

  .cta {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--text);
    font-size: 0.9rem;
    font-weight: 500;
  }

  .cta svg {
    transition: transform 0.3s var(--ease-out);
  }

  .card:hover .cta {
    color: var(--card-accent);
  }

  .card:hover .cta svg {
    transform: translateX(3px);
  }

  @media (prefers-reduced-motion: reduce) {
    .card,
    .cta svg {
      transition: none;
    }

    .card:hover,
    .card:focus-visible {
      --lift: 0px;
    }
  }
</style>
