---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import SectionIcon from '../../components/SectionIcon.astro';
import { sections, type Section } from '../../lib/sections';
import { getPosts } from '../../lib/posts';

// One static listing page per registered section.
export const getStaticPaths = (() =>
  sections.map((section) => ({ params: { section: section.id }, props: { section } }))) satisfies GetStaticPaths;

interface Props {
  section: Section;
}

const { section } = Astro.props;
const posts = await getPosts(section.id);
---

<BaseLayout title={section.title} description={section.description}>
  <div class="container listing" style={`--accent: ${section.accent}`}>
    <header class="head">
      <span class="icon"><SectionIcon name={section.icon} size={24} /></span>
      <div>
        <p class="tagline mono">{section.tagline}</p>
        <h1>{section.title}</h1>
        <p class="description">{section.description}</p>
      </div>
    </header>

    <p class="count mono">
      {posts.length} {posts.length === 1 ? 'post' : 'posts'} · newest first
    </p>

    {
      posts.length > 0 ? (
        <ol class="posts">
          {posts.map((post) => (
            <li>
              <PostCard post={post} accent={section.accent} />
            </li>
          ))}
        </ol>
      ) : (
        <div class="empty">
          <p class="mono">
            <span class="prompt">$</span> ls ./{section.id}
          </p>
          <p>Nothing here yet. First writeup coming soon.</p>
        </div>
      )
    }
  </div>
</BaseLayout>

<style>
  .listing {
    padding-top: clamp(2.5rem, 6vw, 4.5rem);
    max-width: 920px;
  }

  .head {
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
  }

  .icon {
    flex: none;
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    margin-top: 0.25rem;
    border: 1px solid color-mix(in oklab, var(--accent) 25%, var(--border));
    border-radius: 14px;
    background: color-mix(in oklab, var(--accent) 9%, var(--surface));
    color: var(--accent);
    box-shadow: var(--highlight), var(--shadow-1);
  }

  .tagline {
    color: var(--accent);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h1 {
    margin-top: 0.3rem;
    font-size: clamp(2.2rem, 5vw, 3rem);
    font-weight: 600;
  }

  .description {
    max-width: 60ch;
    margin-top: 0.75rem;
    color: var(--text-muted);
    font-size: 1.05rem;
  }

  .count {
    margin-top: 2.5rem;
    padding-bottom: 0.9rem;
    border-bottom: 1px solid var(--border);
    color: var(--text-faint);
    font-size: 0.78rem;
  }

  .posts {
    display: grid;
    gap: 1rem;
    margin-top: 1.5rem;
    padding: 0;
    list-style: none;
  }

  .empty {
    margin-top: 1.5rem;
    padding: 2.5rem 1.5rem;
    border: 1px dashed var(--border-strong);
    border-radius: var(--radius);
    color: var(--text-muted);
    text-align: center;
  }

  .empty .mono {
    margin-bottom: 0.5rem;
    color: var(--text-faint);
    font-size: 0.85rem;
  }

  .prompt {
    color: var(--accent);
  }

  @media (max-width: 520px) {
    .head {
      flex-direction: column;
      gap: 1rem;
    }
  }
</style>
