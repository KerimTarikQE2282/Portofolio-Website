---
import { withBase } from '../lib/url';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Not found">
  <div class="container wrap">
    <p class="code mono">404</p>
    <h1>Nothing at this path.</h1>
    <p class="mono hint"><span class="prompt">$</span> cd ~</p>
    <a href={withBase('/')} class="home">Back to the homepage</a>
  </div>
</BaseLayout>

<style>
  .wrap {
    padding-block: clamp(4rem, 14vw, 9rem);
    text-align: center;
  }

  .code {
    color: var(--accent);
    font-size: 0.9rem;
    letter-spacing: 0.2em;
  }

  h1 {
    margin-top: 0.75rem;
    font-size: clamp(2rem, 5vw, 3rem);
  }

  .hint {
    margin-top: 1.5rem;
    color: var(--text-faint);
    font-size: 0.9rem;
  }

  .prompt {
    color: var(--accent);
  }

  .home {
    display: inline-block;
    margin-top: 1.5rem;
    padding: 0.6rem 1.1rem;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
    background: var(--surface);
    box-shadow: var(--highlight), var(--shadow-1);
    font-weight: 500;
    transition: border-color 0.15s;
  }

  .home:hover {
    border-color: var(--accent);
  }
</style>
